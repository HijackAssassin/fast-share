<Window x:Class="FastShare.DragGhost"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        IsHitTestVisible="False" Focusable="False"
        FontFamily="Segoe UI">

    <Border x:Name="Chip" CornerRadius="4" Padding="10,6"
            Background="{DynamicResource Chrome}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Opacity="0.95">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource Subtle}"/>
            <TextBlock x:Name="Caption" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text}"/>
        </StackPanel>
    </Border>
</Window>
