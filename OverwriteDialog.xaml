<Window x:Class="FastShare.OverwriteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overwrite files?" Width="500" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Chrome}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI">

    <Border Padding="22,20">
        <StackPanel>
            <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource Subtle}"
                       Text="Each old version is only replaced once its new one has fully arrived."/>

            <!-- Three names to start with; "Show more" opens it to ten lines, and past ten it scrolls. -->
            <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="4"
                    Background="{DynamicResource Content}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <StackPanel>
                    <ScrollViewer x:Name="NamesScroller" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="NamesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Height="20" Padding="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button x:Name="MoreButton" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource Accent}" Click="OnMoreClick"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="OverwriteButton" MinWidth="110" Style="{StaticResource Primary}"
                        Content="Overwrite" Click="OnOverwriteClick"/>
                <Button x:Name="SkipButton" MinWidth="110" IsDefault="True" Click="OnSkipClick"/>
                <Button Content="Cancel" MinWidth="90" Margin="0" IsCancel="True" Click="OnCancelClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
