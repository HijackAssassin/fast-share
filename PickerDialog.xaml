<Window x:Class="FastShare.PickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose what to upload" Width="760" Height="560"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Chrome}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI">

    <DockPanel Margin="14">

        <!-- Address bar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}"
                    Click="OnUpClick" ToolTip="Up one level">
                <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
            </Button>
            <Button DockPanel.Dock="Right" Content="Go" MinWidth="60" Margin="8,0,0,0"
                    Click="OnGoClick"/>
            <TextBox x:Name="PathBox" VerticalAlignment="Center" Margin="6,0,0,0"
                     KeyDown="OnPathKeyDown"/>
        </DockPanel>

        <!-- Shortcuts -->
        <ItemsControl x:Name="Places" DockPanel.Dock="Top" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Name}" Tag="{Binding Path}" Margin="0,0,6,6"
                            Padding="9,3" MinWidth="0" Click="OnPlaceClick"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Basket -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,8" CornerRadius="4"
                Background="{DynamicResource Content}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" MinWidth="70" Margin="8,0,0,0"
                        Click="OnClearBasketClick"/>
                <TextBlock x:Name="BasketText" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Subtle}"
                           Text="Nothing chosen yet."/>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="AddButton" Content="Add selected" MinWidth="120"
                    IsEnabled="False" Click="OnAddClick"
                    ToolTip="Add the highlighted files and folders, then keep browsing for more."/>
            <Button x:Name="UploadButton" Content="Upload" MinWidth="110"
                    Style="{StaticResource Primary}" IsEnabled="False" Click="OnUploadClick"/>
            <Button Content="Cancel" MinWidth="90" Margin="0" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>

        <ListView x:Name="Items" BorderThickness="1"
                  BorderBrush="{DynamicResource Line}"
                  Background="{DynamicResource Content}"
                  Foreground="{DynamicResource Text}"
                  SelectionMode="Extended"
                  SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnItemDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource FolderGlyph}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Modified" Width="160" DisplayMemberBinding="{Binding ModifiedText}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
