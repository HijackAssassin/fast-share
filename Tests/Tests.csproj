<Project Sdk="Microsoft.NET.Sdk">

  <!-- FastShare's own checks, kept with the source so they outlive any one session.
       Compiles the app's real non-UI source files (no copies), runs a real server, client,
       tunnel and transfer engine against generated data in a temp folder, and prints
       PASS/FAIL per check. Run from the project root:

           test.bat   (or: dotnet run, project Tests)

       It sets FASTSHARE_HOME to a temp folder first, so it never reads or writes the real
       config, certificate or log. Nothing here touches the network beyond 127.0.0.1. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS8618;CS0162;CS1998</NoWarn>
    <RootNamespace>FastShare.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <!-- The app's source minus the WPF parts. -->
  <ItemGroup>
    <Compile Include="..\*.cs"
             Exclude="..\MainWindow*.cs;..\*.xaml.cs;..\WpfHelpers.cs;..\TrayIcon.cs;..\Theme.cs;..\ShellDrop.cs"
             Link="App\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
