<Window x:Class="FastShare.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Chrome}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI">

    <!-- Deliberately shaped like the connection request, since it follows straight on from
         one and answering two differently-shaped boxes in a row is jarring. -->
    <Border Padding="22,20">
        <StackPanel>
            <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="SubText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Subtle}"/>

            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="4"
                    Background="{DynamicResource Content}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="12"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="YesButton" MinWidth="120" Style="{StaticResource Primary}"
                        IsDefault="True" Click="OnYesClick"/>
                <Button x:Name="NoButton" MinWidth="100" Margin="0"
                        IsCancel="True" Click="OnNoClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
