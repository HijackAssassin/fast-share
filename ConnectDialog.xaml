<Window x:Class="FastShare.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connecting" Width="430" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Chrome}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI">

    <Border Padding="22,20">
        <StackPanel>

            <StackPanel x:Name="BusyPanel">
                <TextBlock x:Name="BusyText" FontSize="14" TextWrapping="Wrap"
                           Text="Connecting…"/>
                <ProgressBar IsIndeterminate="True" Height="5" Margin="0,16,0,0"
                             BorderThickness="0" Background="{DynamicResource Line}"
                             Foreground="{DynamicResource Accent}"/>
                <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Subtle}"
                           Text="Waiting for the other PC to answer."/>
            </StackPanel>

            <StackPanel x:Name="FailPanel" Visibility="Collapsed">
                <TextBlock Text="Connection failed" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Bad}"/>
                <TextBlock x:Name="FailText" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Subtle}"/>
                <TextBlock x:Name="FailHint" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Subtle}"
                           Text="Usually this means the other PC is not sharing right now, or that port is not forwarded to it."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="RetryButton" Content="Retry" MinWidth="90"
                            Style="{StaticResource Primary}" Click="OnRetryClick"/>
                    <Button Content="Close" MinWidth="90" Margin="0" Click="OnCloseClick"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
