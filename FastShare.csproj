<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FastShare</AssemblyName>
    <RootNamespace>FastShare</RootNamespace>

    <!-- The name Windows shows for the exe (Task Manager, file properties). The file itself stays
         FastShare.exe: updates and firewall rules go by that name. -->
    <Product>Fast Share</Product>
    <AssemblyTitle>Fast Share</AssemblyTitle>

    <!-- Exe, taskbar, title bar and tray icon (TrayIcon pulls it out of the exe). Built from
         FastShareLogo.ico (Resources\Logo\) with the white background made transparent and sizes
         16-256 added. -->
    <ApplicationIcon>FastShare.ico</ApplicationIcon>

    <!-- "What version is this": shown in the title bar and in Settings (and compared with the
         website's by the update check). build.bat passes it as -p:Version=<Website\version.txt>;
         a build without that (Visual Studio, dotnet build) reads ..\Website\version.txt itself,
         and a copy without a Website\ folder (a GitHub clone) builds as 0.0.0. -->
    <VersionFile>$(MSBuildThisFileDirectory)..\Website\version.txt</VersionFile>
    <Version Condition="'$(Version)' == '' And Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</Version>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>

    <!-- Where Check for updates looks when Patrick's update server is not open. It reads this
         page (and its /downloads/ folder) for the newest "Fast-Share-V<version>.rar" link.
         An IP or DuckDNS address works too, e.g. http://1.2.3.4:8080/ - change it here, or
         set FASTSHARE_UPDATE_WEBSITE before running build.bat (build-app.bat passes it on), and
         every build made after that checks the new address. -->
    <UpdateWebsite>https://teamwolfgamers.online/</UpdateWebsite>
    <!-- Tried when UpdateWebsite cannot be reached or has no FastShare download (for when the
         domain lapses). Same NAS, same site; Caddy serves it under both names. -->
    <UpdateWebsiteFallback>https://pattywatty.duckdns.org/</UpdateWebsiteFallback>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

  </PropertyGroup>

  <!-- The standalone update listener is its own project that reuses a few of these sources.
       Its folder must be kept out of this project's wildcard compile, or its Program.cs would
       collide with this app's entry point. -->
  <ItemGroup>
    <Compile Remove="UpdateServer\**" />
    <None Remove="UpdateServer\**" />
    <Page Remove="UpdateServer\**" />
    <!-- Same for the Tests project (it compiles this app's sources itself). -->
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
  </ItemGroup>

  <!-- One app that both hosts and connects, so the wire format has a single definition
       that cannot drift between the two sides. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <!-- Bakes UpdateWebsite into the exe, where WebUpdate.Site reads it back. -->
  <ItemGroup>
    <AssemblyMetadata Include="UpdateWebsite" Value="$(UpdateWebsite)" />
    <AssemblyMetadata Include="UpdateWebsiteFallback" Value="$(UpdateWebsiteFallback)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
