<Window x:Class="FastShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FastShare"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Height="720" Width="1300"
        MinHeight="480" MinWidth="860"
        Background="{DynamicResource Chrome}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
        <local:NotBoolConverter x:Key="NotBool"/>

        <!-- How big the Browse list draws itself. Ctrl+scroll rewrites these three at
             runtime, so every part of a row - glyph, text and row height - grows together
             instead of the text outgrowing the box around it. -->
        <sys:Double x:Key="RowFontSize">13</sys:Double>
        <sys:Double x:Key="RowGlyphSize">15</sys:Double>
        <sys:Double x:Key="RowHeight">24</sys:Double>

        <!-- The tile view, used at every size above the smallest. Bigger targets that are
             easier to click than a thin row, and no columns to squeeze. -->
        <sys:Double x:Key="TileWidth">96</sys:Double>
        <sys:Double x:Key="TileGlyphSize">40</sys:Double>
        <sys:Double x:Key="TileFontSize">12</sys:Double>
        <sys:Double x:Key="TileNameHeight">46</sys:Double>

        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
        </ItemsPanelTemplate>

        <!-- The details view's panel. Set explicitly rather than left null: clearing
             ItemsPanel to null leaves the list with NO panel, so nothing renders at all -
             which is why the details view came up blank after switching back from tiles. -->
        <ItemsPanelTemplate x:Key="DetailsPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <!-- Browse list rows. One look for both views: the details list used Windows' own
             GridView highlight (a pale gradient under white text - unreadable in dark mode)
             while the tiles did not, so the smallest size alone was hard to read. -->
        <Style x:Key="DetailsItemStyle" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="MinHeight" Value="{DynamicResource RowHeight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" MinHeight="{TemplateBinding MinHeight}"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelected}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ItemSelectedBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileItemStyle" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" Padding="2" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelected}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ItemSelectedBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileTemplate">
            <StackPanel Width="{DynamicResource TileWidth}" Margin="6,8"
                        HorizontalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                           FontSize="{DynamicResource TileGlyphSize}"
                           HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource FileGlyph}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource FolderGlyph}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Wraps to several lines and only then trims, so a long name uses the width
                     the bigger tile gives it instead of being cut off after a few letters. -->
                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource TileFontSize}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           MaxHeight="{DynamicResource TileNameHeight}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- A saved host: status light, name, address. -->
        <DataTemplate x:Key="ConnectionTemplate" DataType="{x:Type local:ConnectionRow}">
            <DockPanel Margin="2,4">
                <TextBlock DockPanel.Dock="Left" Text="&#x25CF;" FontSize="15"
                           VerticalAlignment="Center" Margin="2,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Idle}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Online">
                                    <Setter Property="Foreground" Value="{DynamicResource Good}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Offline">
                                    <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11"
                           VerticalAlignment="Center" MinWidth="62" TextAlignment="Right"
                           Foreground="{DynamicResource Subtle}"/>

                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11"
                               Foreground="{DynamicResource Subtle}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- ================= status bar ================= -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource Chrome}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,6"
                ContextMenuOpening="OnStatusMenuOpening">
            <!-- Right-click: Cancel all transfers. Always has a menu, or the event stops firing. -->
            <Border.ContextMenu>
                <ContextMenu/>
            </Border.ContextMenu>
            <DockPanel>
                <TextBlock x:Name="StateDot" DockPanel.Dock="Left" Text="&#x25CF;" FontSize="13"
                           Foreground="{DynamicResource Idle}" VerticalAlignment="Center"
                           Margin="0,0,7,0"/>
                <TextBlock x:Name="StateText" DockPanel.Dock="Left" Text="No Connections"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                <!-- Takes over from the label once more than one thing is connected, because
                     then there is a list worth opening. -->
                <Button x:Name="StateButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}"
                        Visibility="Collapsed" Margin="0,0,14,0" Padding="0"
                        Click="OnConnectedToClick" ToolTip="Show everyone connected">
                    <TextBlock x:Name="StateButtonText" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}"/>
                </Button>
                <TextBlock x:Name="PingText" DockPanel.Dock="Left" Text=""
                           VerticalAlignment="Center" Foreground="{DynamicResource Subtle}"
                           Margin="0,0,14,0"/>

                <!-- Reads left to right: "Download 560 Mbit/s [bar]  Upload 0 Mbit/s [bar]". Docked
                     from the right, so declared in reverse. Word, speed and bar sit tight together (no fixed
                     width on the speed, which left a gap before the bar). The bars are always there - empty
                     while nothing moves that way - so the bar does not jump when a transfer
                     starts, whether we started it or the other PC did. -->
                <ProgressBar x:Name="UpProgress" DockPanel.Dock="Right" Width="110" Height="6"
                             Margin="8,0,0,0" BorderThickness="0" Value="0"
                             ToolTip="Sending"
                             Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}"/>
                <TextBlock x:Name="UpSpeedText" DockPanel.Dock="Right" Text="0 Mbit/s"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="5,0,0,0"
                           ToolTip="Sending"/>
                <TextBlock DockPanel.Dock="Right" Text="Upload" VerticalAlignment="Center"
                           Margin="20,0,0,0" Foreground="{DynamicResource Subtle}"/>
                <ProgressBar x:Name="DownProgress" DockPanel.Dock="Right" Width="110" Height="6"
                             Margin="8,0,0,0" BorderThickness="0" Value="0"
                             ToolTip="Receiving"
                             Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}"/>
                <TextBlock x:Name="DownSpeedText" DockPanel.Dock="Right" Text="0 Mbit/s"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="5,0,0,0"
                           ToolTip="Receiving"/>
                <TextBlock DockPanel.Dock="Right" Text="Download" VerticalAlignment="Center"
                           Margin="14,0,0,0" Foreground="{DynamicResource Subtle}"/>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}"
                        Visibility="Collapsed" Margin="4,0,0,0" Padding="6,2" MinWidth="24"
                        Click="OnCancelClick" ToolTip="Cancel this transfer">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{DynamicResource Bad}"/>
                </Button>

                <TextBlock x:Name="TransferText" Text="" VerticalAlignment="Center"
                           Foreground="{DynamicResource Subtle}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

      <Grid>
        <!-- Settings and theme sit over the tab strip, top right, where a title bar would
             normally put them. -->
        <StackPanel Orientation="Horizontal" Panel.ZIndex="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0">
            <!-- Shown by the quiet update check when a newer build exists. -->
            <Button x:Name="UpdateAvailableButton" Style="{StaticResource Ghost}" Visibility="Collapsed"
                    Click="OnUpdateAvailableClick" Margin="0,0,6,0"
                    ToolTip="A newer FastShare is available. Click to install it (FastShare restarts by itself).">
                <TextBlock x:Name="UpdateAvailableText" Text="Update available" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"/>
            </Button>
            <Button x:Name="ThemeButton" Style="{StaticResource Ghost}" Click="OnThemeClick"
                    ToolTip="Switch between light and dark">
                <TextBlock x:Name="ThemeGlyph" Text="&#xE708;" FontFamily="Segoe MDL2 Assets"
                           FontSize="14"/>
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource Ghost}" Margin="0"
                    Click="OnSettingsClick" ToolTip="Settings">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
            </Button>
        </StackPanel>

        <TabControl x:Name="Tabs" Background="{DynamicResource Chrome}" BorderThickness="0" Padding="0">

            <!-- ================= CONNECTIONS ================= -->
            <TabItem x:Name="ConnectionsTab" Header="Connections">
                <Border Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,1,0,0" Padding="16">
                    <!-- Two columns pinned left: connecting and the recent list on the left,
                         a Favorites shortlist on the right. -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="820"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Connect to a PC" FontSize="14"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <DockPanel Grid.Row="1" Margin="0,0,0,18">
                                <Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="Connect"
                                        Style="{StaticResource Primary}" MinWidth="100" Margin="8,0,0,0"
                                        Click="OnConnectClick"/>
                                <TextBox x:Name="CodeBox" FontFamily="Consolas" FontSize="11"
                                         KeyDown="OnCodeBoxKeyDown"
                                         ToolTip="Paste a FastShare code, or the other PC's local address (e.g. 192.168.1.100) if it is on your network. Type localhost to browse your own shares."/>
                            </DockPanel>

                            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh"
                                        MinWidth="90" Margin="0" Click="OnRefreshClick"/>
                                <TextBlock Text="Recent connections" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <ListBox x:Name="RecentList" Grid.Row="3" MinHeight="200"
                                     ItemTemplate="{StaticResource ConnectionTemplate}"
                                     HorizontalContentAlignment="Stretch"
                                     PreviewMouseRightButtonDown="OnRecentRightDown"
                                     PreviewMouseLeftButtonDown="OnRecentMouseDown"
                                     SelectionChanged="OnRecentSelectionChanged"
                                     MouseDoubleClick="OnRecentDoubleClick">
                                <ListBox.ContextMenu>
                                    <ContextMenu Opened="OnRecentMenuOpened">
                                        <MenuItem x:Name="RecentMenuConnect" Header="Connect"
                                                  Click="OnRecentConnectClick"/>
                                        <MenuItem x:Name="RecentMenuFavorite" Header="Add to favorites"
                                                  Click="OnRecentFavoriteClick"/>
                                        <MenuItem x:Name="RecentMenuRename" Header="Rename&#x2026;"
                                                  Click="OnRecentRenameClick"/>
                                        <MenuItem x:Name="RecentMenuBlock" Header="Block"
                                                  Click="OnRecentBlockClick"/>
                                        <Separator/>
                                        <MenuItem x:Name="RecentMenuForget" Header="Forget"
                                                  Click="OnForgetClick"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>

                            <DockPanel Grid.Row="4" Margin="0,10,0,0">
                                <Button x:Name="ForgetButton" DockPanel.Dock="Right" Content="Forget"
                                        Style="{StaticResource Danger}" MinWidth="90" Margin="8,0,0,0"
                                        IsEnabled="False" Click="OnForgetClick"/>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,7,0"
                                           Foreground="{DynamicResource Subtle}"/>
                                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                                         ToolTip="Filter by name or address"/>
                            </DockPanel>
                        </Grid>

                        <!-- Favorites: a shortlist. Double-click to connect; right-click
                             to remove. Added from a right-click on the recent list or on someone
                             in the Share tab's Permissions. -->
                        <StackPanel Grid.Column="1" Width="300" Margin="28,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="Favorites" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="FavoritesEmpty"
                                       Text="No favorites yet. Right-click someone in Recent connections, or in User Permissions on the Share tab, to add them."
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Subtle}"/>

                            <ListBox x:Name="FavoritesList" MinHeight="200"
                                     Visibility="Collapsed"
                                     HorizontalContentAlignment="Stretch"
                                     MouseDoubleClick="OnFavoriteDoubleClick">
                                <ListBox.ContextMenu>
                                    <ContextMenu Opened="OnFavoriteMenuOpened">
                                        <MenuItem x:Name="FavoriteMenuConnect" Header="Connect"
                                                  Click="OnFavoriteConnectClick"/>
                                        <MenuItem x:Name="FavoriteMenuBlock" Header="Block"
                                                  Click="OnFavoriteBlockClick"/>
                                        <Separator/>
                                        <MenuItem x:Name="FavoriteMenuRemove" Header="Remove from favorites"
                                                  Click="OnFavoriteRemoveClick"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:FavoriteRow}">
                                        <DockPanel Margin="2,4">
                                            <!-- Same status dot as Recent connections: green when
                                                 online or connected, red when offline. No star -
                                                 everything in this box is already a favorite. -->
                                            <TextBlock DockPanel.Dock="Left" Text="&#x25CF;" FontSize="15"
                                                       VerticalAlignment="Center" Margin="2,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Idle}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Online">
                                                                <Setter Property="Foreground" Value="{DynamicResource Good}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Offline">
                                                                <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       MinWidth="62" TextAlignment="Right"
                                                       Foreground="{DynamicResource Subtle}"/>

                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Other PCs on this network running FastShare - green when sharing, red
                                 when not - found by one broadcast every few seconds while this tab is
                                 open. Double-click to connect. -->
                            <TextBlock Text="On your network" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,8"/>
                            <TextBlock x:Name="LanEmpty" Text="Looking for other PCs running FastShare on your network…"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Subtle}"/>
                            <ListBox x:Name="LanList" MaxHeight="200" Visibility="Collapsed"
                                     HorizontalContentAlignment="Stretch"
                                     MouseDoubleClick="OnLanDoubleClick">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Connect" Click="OnLanConnectClick"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:LanRow}">
                                        <DockPanel Margin="2,4">
                                            <TextBlock DockPanel.Dock="Left" Text="&#x25CF;" FontSize="15"
                                                       VerticalAlignment="Center" Margin="2,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Online">
                                                                <Setter Property="Foreground" Value="{DynamicResource Good}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       MinWidth="62" TextAlignment="Right"
                                                       Foreground="{DynamicResource Subtle}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{DynamicResource Subtle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Blocked: the same list Settings manages, where it can be seen. -->
                            <TextBlock Text="Blocked" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,8"/>
                            <TextBlock x:Name="BlockedEmpty" Text="Nobody is blocked."
                                       FontSize="12" Foreground="{DynamicResource Subtle}"/>
                            <ListBox x:Name="BlockedPeersList" MaxHeight="160" Visibility="Collapsed"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="OnBlockedSelectionChanged">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Unblock" Click="OnUnblockPeerClick"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,4">
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource Subtle}"
                                                       Text="{Binding BlockedUtc, StringFormat=d}"/>
                                            <TextBlock Text="{Binding Username}" FontSize="13" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="UnblockPeerButton" Content="Unblock" HorizontalAlignment="Left"
                                    MinWidth="90" Margin="0,6,0,0" IsEnabled="False" Visibility="Collapsed"
                                    Click="OnUnblockPeerClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ================= BROWSE ================= -->
            <TabItem x:Name="BrowseTab" Header="Browse">
                <!-- The tree is a full-height column of its own and the toolbar lives inside the
                     right-hand pane, so the back/forward/up buttons and the path bar begin
                     exactly where the file list begins - and stay lined up when the splitter
                     is dragged. -->
                <Grid Background="{DynamicResource Chrome}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="170"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- One stacked list: each connection's root, then its folders,
                         then the next connection. Two separate lists meant the same names
                         appeared twice and it was never clear which folders belonged to
                         whom. -->
                    <DockPanel Grid.Column="0" Background="{DynamicResource Chrome}">
                        <TextBlock DockPanel.Dock="Top" Text="Folders Shared With You"
                                   FontSize="12" FontWeight="SemiBold"
                                   Margin="10,10,8,6" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Subtle}"/>

                        <ListBox x:Name="ShareSidebar" BorderThickness="0" Padding="4,0"
                                 Background="{DynamicResource Chrome}"
                                 Foreground="{DynamicResource Text}"
                                 FontSize="15"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewMouseRightButtonDown="OnSidebarRightDown"
                                 SelectionChanged="OnSidebarShareSelected">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="OnSidebarMenuOpened">
                                    <MenuItem x:Name="SidebarMenuClose" Header="Close"
                                              Click="OnSidebarDisconnectClick"/>
                                    <MenuItem x:Name="SidebarMenuOpen" Header="Open"
                                              Click="OnSidebarOpenClick"/>
                                    <MenuItem x:Name="SidebarMenuDownload" Header="Download this folder"
                                              Click="OnSidebarDownloadClick"/>
                                    <MenuItem x:Name="SidebarMenuRename" Header="Rename&#x2026;"
                                              Click="OnSidebarRenameClick"/>
                                    <Separator x:Name="SidebarMenuSeparator"/>
                                    <MenuItem x:Name="SidebarMenuReject" Header="Kick"
                                              Click="OnSidebarRejectClick"/>
                                    <MenuItem x:Name="SidebarMenuBlock" Header="Block"
                                              Click="OnSidebarBlockClick"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,2,1,2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Margin="{Binding Indent}">
                                        <DockPanel>
                                            <!-- Closes this connection in one click, same as right-click, Close.
                                                 Red outline like Close All Connections; full row height,
                                                 against the right edge. -->
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Danger}"
                                                    Visibility="{Binding CloseVisibility}" Tag="{Binding}"
                                                    Width="30" MinWidth="0" Padding="0" Margin="6,2,0,2"
                                                    VerticalAlignment="Stretch"
                                                    Click="OnSidebarRowCloseClick" ToolTip="Close">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource PersonGlyph}"/>
                                                <TextBlock Text="{Binding Label}" FontSize="15"
                                                           VerticalAlignment="Center"
                                                           FontWeight="{Binding Weight}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource Line}"/>

                <DockPanel Grid.Column="2">

                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,1,0,1" Padding="10,8">
                        <DockPanel>
                            <!-- Back / forward / up sit immediately left of the path, the way
                                 Explorer arranges them, rather than drifting off on their own. -->
                            <Button x:Name="BackButton" Style="{StaticResource Ghost}" IsEnabled="False"
                                    Click="OnBackClick" ToolTip="Back">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </Button>
                            <Button x:Name="ForwardButton" Style="{StaticResource Ghost}" IsEnabled="False"
                                    Click="OnForwardClick" ToolTip="Forward">
                                <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </Button>
                            <Button x:Name="UpButton" Style="{StaticResource Ghost}" IsEnabled="False"
                                    Click="OnUpClick" ToolTip="Up one level">
                                <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </Button>

                            <Button x:Name="DisconnectButton" DockPanel.Dock="Right" Content="Close All Connections"
                                    Style="{StaticResource Danger}" IsEnabled="False"
                                    Click="OnDisconnectAllClick"
                                    ToolTip="Close everything you are browsing. This does not stop sharing your own folders — use the Share tab for that."/>

                            <!-- Delete sits between Upload and Close All Connections, so the
                                 destructive actions are grouped at the right end. -->
                            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="Delete"
                                    Style="{StaticResource Danger}" IsEnabled="False"
                                    Margin="0,0,6,0" Click="OnDeleteClick"
                                    ToolTip="Permanently delete the selected items."/>

                            <!-- One Upload button covering both files and folders: the split
                                 made you decide which kind you were sending before the picker
                                 had even opened. Outlined rather than filled, so Download stays
                                 the obvious primary action. -->
                            <Button x:Name="UploadButton" DockPanel.Dock="Right" Content="Upload"
                                    Style="{StaticResource Outline}" IsEnabled="False"
                                    Click="OnUploadClick"/>
                            <Button x:Name="DownloadButton" DockPanel.Dock="Right" Content="Download"
                                    Style="{StaticResource Primary}" IsEnabled="False"
                                    Click="OnDownloadClick"/>

                            <!-- Clickable breadcrumbs: every level is a jump, not just text. -->
                            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="4" Margin="6,0,8,0" Padding="6,0">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy address" Click="OnCopyAddressClick"/>
                                        <MenuItem Header="Copy folder name" Click="OnCopyFolderNameClick"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <ScrollViewer x:Name="CrumbScroller"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="Crumbs" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding Name}" Tag="{Binding Path}"
                                                            Style="{StaticResource Ghost}" Margin="0"
                                                            Padding="5,3" MinWidth="0"
                                                            Click="OnCrumbClick"/>
                                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="9" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Subtle}"
                                                               Visibility="{Binding ChevronVisibility}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>

                        <Grid AllowDrop="True"
                              DragOver="OnFileListDragOver" Drop="OnFileListDrop">
                        <!-- Shown over the list when there is nothing in it, so an empty share
                             reads as an answer rather than as a screen that failed to load. -->
                        <TextBlock x:Name="EmptyHint" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="20" TextWrapping="Wrap" TextAlignment="Center"
                                   FontSize="13" Foreground="{DynamicResource Subtle}"
                                   Panel.ZIndex="1" IsHitTestVisible="False"/>

                        <!-- Sits over the list, drawn only while rubber-banding. -->
                        <Canvas x:Name="MarqueeLayer" Panel.ZIndex="2" IsHitTestVisible="False">
                            <Rectangle x:Name="Marquee" Visibility="Collapsed"
                                       Fill="#330078D4" Stroke="{DynamicResource Accent}"
                                       StrokeThickness="1"/>
                        </Canvas>

                        <ListView x:Name="FileList" BorderThickness="0"
                                  Background="{DynamicResource Content}"
                                  Foreground="{DynamicResource Text}"
                                  FontSize="{DynamicResource RowFontSize}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SizeChanged="OnFileListSizeChanged"
                                  SelectionMode="Extended"
                                  PreviewMouseWheel="OnFileListMouseWheel"
                                  MouseDoubleClick="OnItemDoubleClick"
                                  SelectionChanged="OnSelectionChanged"
                                  GridViewColumnHeader.Click="OnHeaderClick"
                                  KeyDown="OnFileListKeyDown"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="OnFileListMouseDown"
                                  PreviewMouseMove="OnFileListMouseMove"
                                  PreviewMouseLeftButtonUp="OnFileListMouseUp"
                                  DragOver="OnFileListDragOver"
                                  Drop="OnFileListDrop">
                            <ListView.ContextMenu>
                                <ContextMenu x:Name="FileMenu" Opened="OnContextMenuOpened">
                                    <MenuItem x:Name="MenuDownload" Header="Download"
                                              Click="OnDownloadClick"/>
                                    <MenuItem x:Name="MenuUpload" Header="Upload here"
                                              Click="OnUploadClick"/>
                                    <Separator/>
                                    <MenuItem x:Name="MenuCompress" Header="Compress to .rar"
                                              Click="OnCompressClick"/>
                                    <MenuItem x:Name="MenuExtract" Header="Extract here"
                                              Click="OnExtractClick"/>
                                    <Separator x:Name="MenuArchiveSeparator"/>
                                    <MenuItem x:Name="MenuNewFolder" Header="New folder"
                                              Click="OnNewFolderClick"/>
                                    <MenuItem x:Name="MenuNewFile" Header="New file"
                                              Click="OnNewFileClick"/>
                                    <Separator/>
                                    <MenuItem x:Name="MenuCopy" Header="Copy" InputGestureText="Ctrl+C"
                                              Click="OnCopyClick"/>
                                    <MenuItem x:Name="MenuCut" Header="Cut" InputGestureText="Ctrl+X"
                                              Click="OnCutClick"/>
                                    <MenuItem x:Name="MenuPaste" Header="Paste" InputGestureText="Ctrl+V"
                                              Click="OnPasteClick"/>
                                    <Separator/>
                                    <MenuItem x:Name="MenuRename" Header="Rename" InputGestureText="F2"
                                              Click="OnRenameItemClick"/>
                                    <MenuItem x:Name="MenuDelete" Header="Delete" InputGestureText="Del"
                                              Click="OnDeleteClick"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView x:Name="DetailsView">
                                    <GridViewColumn x:Name="NameColumn" Width="360">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Name" Tag="Name"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="{DynamicResource RowGlyphSize}"
                                                               Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource FileGlyph}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource FolderGlyph}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                               FontSize="{DynamicResource RowFontSize}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="140">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Date created" Tag="Created"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CreatedText}"
                                                           FontSize="{DynamicResource RowFontSize}"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="140">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Date modified" Tag="Modified"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ModifiedText}"
                                                           FontSize="{DynamicResource RowFontSize}"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="120">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Type" Tag="Type"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TypeText}"
                                                           FontSize="{DynamicResource RowFontSize}"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="100">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Size" Tag="Size"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeText}"
                                                           FontSize="{DynamicResource RowFontSize}"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        </Grid>
                </DockPanel>
                </Grid>
            </TabItem>

            <!-- ================= SHARE ================= -->
            <TabItem x:Name="ShareTab" Header="Share">
                <!-- Three columns, each its own concern and none able to shove the others
                     around: turning sharing on and the code to hand out on the left, the
                     folders being shared in the middle, and live control of whoever is
                     connected on the right. -->
                <ScrollViewer Background="{DynamicResource Chrome}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                <Border BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,1,0,0" Padding="16">
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Width="380"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">

                            <!-- A plain label beside a coloured switch: green ON, red OFF,
                                 so the state reads at a glance rather than from the wording
                                 of a button. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Sharing" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button x:Name="ShareToggleButton" MinWidth="88" Height="34"
                                        Padding="14,0" Foreground="White" BorderThickness="1"
                                        Click="OnShareToggleClick">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Spins only while the startup port check runs, so the
                                             button cannot be pressed into a clash with the
                                             throwaway listener that check briefly binds. -->
                                        <TextBlock x:Name="ShareSpinner" Text="&#xE9F5;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Foreground="White"
                                                   Visibility="Collapsed"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="ShareSpin"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock x:Name="ShareOnOffText" Text="OFF"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Who can reach this PC, line by line: the local network and the
                                 internet are separate questions (a shut port only stops the
                                 second), and the last two lines say why the internet one is
                                 what it is. Filled in by UpdateNetStatus. -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Local connection:" Margin="0,0,10,2"
                                           Foreground="{DynamicResource Subtle}"
                                           ToolTip="PCs on your own network (same house) connecting to you."/>
                                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,2">
                                    <Button x:Name="FixFirewallButton" DockPanel.Dock="Right" Content="Fix"
                                            Margin="8,0,0,0" Padding="10,0" MinWidth="0"
                                            Visibility="Collapsed" Click="OnFixFirewallClick"
                                            ToolTip="Allows FastShare through Windows Firewall (one Windows prompt)."/>
                                    <TextBlock x:Name="NetLocalText" Text="Off" FontWeight="SemiBold"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Subtle}"/>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="Remote connection:" Margin="0,0,10,2"
                                           Foreground="{DynamicResource Subtle}"
                                           ToolTip="PCs anywhere on the internet connecting to you with your code. When this is No, you can still connect to them - and they can share back to you over that connection."/>
                                <TextBlock x:Name="NetRemoteText" Grid.Row="1" Grid.Column="1" Text="Off"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"
                                           Foreground="{DynamicResource Subtle}"/>
                                <TextBlock Grid.Row="2" Text="Port:" Margin="0,0,10,2"
                                           Foreground="{DynamicResource Subtle}"
                                           ToolTip="Whether your share port answers from the internet - forwarded on the router, or opened by UPnP."/>
                                <TextBlock x:Name="NetPortText" Grid.Row="2" Grid.Column="1" Text="Checking…"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"
                                           Foreground="{DynamicResource Subtle}"/>
                                <TextBlock Grid.Row="3" Text="UPnP:" Margin="0,0,10,0"
                                           Foreground="{DynamicResource Subtle}"
                                           ToolTip="FastShare asking the router to open the port by itself. Many routers do not answer; forwarding the port on the router does the same job."/>
                                <TextBlock x:Name="NetUpnpText" Grid.Row="3" Grid.Column="1" Text="Checking…"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Subtle}"/>
                            </Grid>

                            <TextBlock x:Name="ShareStatusText" Text="Not sharing."
                                       Margin="0,0,0,12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Subtle}"/>

                            <TextBlock x:Name="SharePortText" Margin="0,0,0,16"
                                       Foreground="{DynamicResource Subtle}"/>

                            <TextBlock Text="Connection code" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DockPanel>
                                <Button x:Name="NewCodeButton" DockPanel.Dock="Right" Content="New Code"
                                        MinWidth="100" Margin="8,0,0,0"
                                        Click="OnNewCodeClick"
                                        ToolTip="Makes a new code. The old one stops working for everyone, including people who connected before, until you give them the new one."/>
                                <Button x:Name="CopyCodeButton" DockPanel.Dock="Right" Content="Copy Code"
                                        MinWidth="110" IsEnabled="False" Margin="8,0,0,0"
                                        Click="OnCopyCodeClick"/>
                                <TextBox x:Name="ShareCodeBox" IsReadOnly="True" FontFamily="Consolas"
                                         FontSize="11"
                                         Text="Start sharing to generate a code."/>
                            </DockPanel>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Subtle}"
                                       Text="Give this code to someone and they can ask to connect - from anywhere, or from the same house (it finds this PC on the local network by itself). You approve each request and choose what they may do. New Code replaces it; the old one then stops working."/>

                            <TextBlock Text="Folders you are sharing" FontSize="14"
                                       FontWeight="SemiBold" Margin="0,22,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Fixed height with its own scrollbar: the box stays put
                                     however many folders are in it. -->
                                <ListBox x:Name="ShareList" Grid.Column="0" Height="170"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnShareSelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="ToolTip" Value="{Binding}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ContextMenu>
                                        <ContextMenu Opened="OnShareMenuOpened">
                                            <MenuItem x:Name="ShareMenuOpen" Header="Open in Explorer"
                                                      Click="OnOpenShareInExplorerClick"/>
                                            <Separator/>
                                            <MenuItem x:Name="ShareMenuRemove" Header="Remove"
                                                      Click="OnRemoveFolderClick"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                </ListBox>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                    <Button x:Name="AddFolderButton" Content="Add Folder&#x2026;" MinWidth="120"
                                            Margin="0,0,0,6" Click="OnAddFolderClick"/>
                                    <Button x:Name="RemoveFolderButton" Content="Remove" MinWidth="120"
                                            IsEnabled="False" Click="OnRemoveFolderClick"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- column 2: live control over whoever is connected -->
                        <StackPanel Grid.Column="1" Width="340" Margin="28,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="User Permissions" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <!-- An empty list box was a black rectangle with nothing to say.
                                 When nobody is connected, say that instead. -->
                            <TextBlock x:Name="SessionEmptyText"
                                       Text="Nobody is connected to you right now."
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Subtle}"/>

                            <ListBox x:Name="SessionList" MaxHeight="120"
                                     Visibility="Collapsed"
                                     HorizontalContentAlignment="Stretch"
                                     PreviewMouseLeftButtonDown="OnSessionListClick"
                                     PreviewMouseRightButtonDown="OnSessionRightDown"
                                     SelectionChanged="OnSessionSelectionChanged">
                                <ListBox.ContextMenu>
                                    <ContextMenu Opened="OnSessionMenuOpened">
                                        <MenuItem x:Name="SessionMenuConnect" Header="Connect"
                                                  Click="OnSessionConnectClick"/>
                                        <MenuItem x:Name="SessionMenuFavorite" Header="Add to favorites"
                                                  Click="OnSessionFavoriteClick"/>
                                        <MenuItem x:Name="SessionMenuRename" Header="Rename&#x2026;"
                                                  Click="OnSessionRenameClick"/>
                                        <Separator/>
                                        <MenuItem x:Name="SessionMenuDisconnect" Header="Stop sharing with them"
                                                  Click="OnDisconnectSessionClick"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,4">
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{DynamicResource Subtle}"
                                                       Text="{Binding Permissions.Summary}"/>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Grows to fit rather than reserving a fixed block of pixels
                                 that sat empty whenever nobody was selected. -->
                            <Border x:Name="SessionEditor" Visibility="Collapsed" Margin="0,10,0,0"
                                    MaxHeight="440"
                                    Padding="14,12" CornerRadius="4"
                                    Background="{DynamicResource Content}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="SessionEditorName" FontWeight="SemiBold"
                                               Margin="0,0,0,10"/>

                                    <CheckBox x:Name="PeerDownload" Style="{StaticResource Switch}"
                                              Content="Download" Click="OnPeerPermissionChanged"/>
                                    <CheckBox x:Name="PeerSend" Style="{StaticResource Switch}"
                                              Content="Upload" Click="OnPeerPermissionChanged"/>
                                    <CheckBox x:Name="PeerModify" Style="{StaticResource Switch}"
                                              Content="Modify" Click="OnPeerPermissionChanged"/>
                                    <CheckBox x:Name="PeerDelete" Style="{StaticResource Switch}"
                                              Content="Delete" Click="OnPeerPermissionChanged"/>

                                    <CheckBox x:Name="PeerAutoApprove" Margin="0,8,0,4"
                                              Foreground="{DynamicResource Text}"
                                              Content="Allow this user to connect without requesting"
                                              ToolTip="Only when their PC proves it is the same one you let in before (FastShare 2.4 or later on their side)."
                                              Click="OnPeerAutoApproveChanged"/>

                                    <TextBlock Text="Folders they can see" FontWeight="SemiBold"
                                               Margin="0,6,0,6"/>
                                    <ItemsControl x:Name="PeerFolders">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}" Margin="0,3"
                                                          Foreground="{DynamicResource Text}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Click="OnPeerPermissionChanged"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="SessionEditorStatus" Margin="0,10,0,0"
                                               FontSize="11" Foreground="{DynamicResource Subtle}"
                                               TextWrapping="Wrap"
                                               Text="Changes apply immediately, reach their screen at once, and are remembered for the next time they connect."/>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- column 3: limits on particular folders, which beat any user's own permissions -->
                        <StackPanel Grid.Column="2" Width="330" Margin="28,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="Folder Permissions" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Subtle}"
                                       Text="Turn something off for a folder and nobody can do it there or inside it, whatever their own permissions say."/>

                            <ListBox x:Name="FolderRuleList" MaxHeight="170"
                                     HorizontalContentAlignment="Stretch"
                                     PreviewMouseLeftButtonDown="OnFolderRuleListClick"
                                     PreviewMouseRightButtonDown="OnFolderRuleRightDown"
                                     SelectionChanged="OnFolderRuleSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,4" ToolTip="{Binding Path}">
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{DynamicResource Subtle}"
                                                       Text="{Binding Summary}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Add a folder inside a share&#x2026;" Margin="0,0,6,0"
                                        Click="OnAddFolderRuleClick"
                                        ToolTip="Set limits on one folder inside a shared folder."/>
                                <Button x:Name="RemoveFolderRuleButton" Content="Remove" MinWidth="80"
                                        IsEnabled="False" Click="OnRemoveFolderRuleClick"/>
                            </StackPanel>

                            <Border x:Name="FolderRuleEditor" Visibility="Collapsed" Margin="0,10,0,0"
                                    Padding="14,12" CornerRadius="4"
                                    Background="{DynamicResource Content}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="FolderRuleName" FontWeight="SemiBold" Margin="0,0,0,10"
                                               TextWrapping="Wrap"/>
                                    <CheckBox x:Name="RuleDownload" Style="{StaticResource Switch}"
                                              Content="Download" Click="OnFolderRuleChanged"/>
                                    <CheckBox x:Name="RuleSend" Style="{StaticResource Switch}"
                                              Content="Upload" Click="OnFolderRuleChanged"/>
                                    <CheckBox x:Name="RuleModify" Style="{StaticResource Switch}"
                                              Content="Modify" Click="OnFolderRuleChanged"/>
                                    <CheckBox x:Name="RuleDelete" Style="{StaticResource Switch}"
                                              Content="Delete" Click="OnFolderRuleChanged"/>
                                    <TextBlock x:Name="FolderRuleStatus" Margin="0,8,0,0" FontSize="11"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Subtle}"
                                               Text="On: each person's own permission applies. Off: nobody, in this folder and everything inside it."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Activity Log">
                <DockPanel Background="{DynamicResource Chrome}">

                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,1,0,1" Padding="12,10">
                        <DockPanel>
                            <ComboBox x:Name="LogViewPicker" DockPanel.Dock="Right" MinWidth="120"
                                      Margin="0" VerticalAlignment="Center"
                                      SelectionChanged="OnLogViewChanged"
                                      ToolTip="Which kind of events to show">
                                <ComboBoxItem Content="Transfers" IsSelected="True"/>
                                <ComboBoxItem Content="Events"/>
                                <ComboBoxItem Content="Failed"/>
                            </ComboBox>
                            <WrapPanel x:Name="StatsPanel" Orientation="Horizontal">
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Download size" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="StatDown" Text="0 B" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Sent size" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="StatUp" Text="0 B" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Downloaded folders/files" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="StatDownItems" Text="0 / 0" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Sent folders/files" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="StatUpItems" Text="0 / 0" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Peak rate" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="StatPeak" Text="0 B/s" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Session" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="StatUptime" Text="--:--" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Errors" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="StatErrors" Text="0" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Whether this PC can actually be reached from outside, which
                                     is the difference between being able to host and not. -->
                                <StackPanel>
                                    <TextBlock Text="Port" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="StatPort" Text="Not sharing" FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Subtle}"
                                               ToolTip="Checked once at startup by connecting to your own public address. Some routers refuse that even when the port is forwarded, which shows as Unknown."/>
                                </StackPanel>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- The queue: what is running and what is waiting, per direction. Only shown
                         while there is something in it. -->
                    <Border x:Name="QueuePanel" DockPanel.Dock="Top" Visibility="Collapsed"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                                <Button x:Name="QueueUpButton" Content="Move up" MinWidth="96" Margin="0,0,0,4"
                                        Click="OnQueueUpClick" ToolTip="Run this one sooner"/>
                                <Button x:Name="QueueDownButton" Content="Move down" MinWidth="96" Margin="0,0,0,4"
                                        Click="OnQueueDownClick" ToolTip="Run this one later"/>
                                <Button x:Name="QueueCancelButton" Content="Remove" MinWidth="96" Margin="0"
                                        Style="{StaticResource Danger}" Click="OnQueueCancelClick"
                                        ToolTip="Take a waiting transfer out of the queue, or cancel the running one"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Queue" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ListBox x:Name="QueueList" MaxHeight="120" DisplayMemberPath="Label"
                                     SelectionChanged="OnQueueSelectionChanged"/>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <!-- Transfers: one row per transfer, the same columns the History tab
                             uses, so a thing you did reads identically while it is happening
                             and after it has finished. It used to be one line per file, which
                             turned a folder of ten thousand small files into ten thousand
                             rows and told you nothing about who or which way. -->
                        <ListView x:Name="TransferLog" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SizeChanged="OnTransferLogSizeChanged"
                                  ContextMenuOpening="OnTransferMenuOpening"
                                  Background="{DynamicResource Content}"
                                  Foreground="{DynamicResource Text}"
                                  MouseDoubleClick="OnTransferRowActivated"
                                  KeyDown="OnTransferLogKeyDown"
                                  PreviewMouseLeftButtonDown="OnTransferLogClick"
                                  ToolTip="Double-click a transfer to see every file in it."
                                  VirtualizingPanel.IsVirtualizing="True">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Timestamp" Width="82"
                                                    DisplayMemberBinding="{Binding WhenText}"/>
                                    <GridViewColumn Header="User" Width="110"
                                                    DisplayMemberBinding="{Binding Peer}"/>
                                    <GridViewColumn Header="Direction" Width="175"
                                                    DisplayMemberBinding="{Binding Arrow}"/>
                                    <GridViewColumn Header="Contents" Width="105"
                                                    DisplayMemberBinding="{Binding ContentsText}"/>
                                    <GridViewColumn Header="Size" Width="120"
                                                    DisplayMemberBinding="{Binding SizeText}"/>
                                    <GridViewColumn Header="Progress" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Width="118" Height="16">
                                                    <Grid Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisible}}">
                                                        <ProgressBar Minimum="0" Maximum="100"
                                                                     Value="{Binding Percent, Mode=OneWay}"
                                                                     IsIndeterminate="{Binding HasPercent, Converter={StaticResource NotBool}}"
                                                                     BorderThickness="0"
                                                                     Foreground="{DynamicResource Accent}"
                                                                     Background="{DynamicResource Line}"/>
                                                        <TextBlock Text="{Binding PercentText}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Text}"/>
                                                    </Grid>
                                                    <!-- Finished: how it ended, in place of the bar. -->
                                                    <TextBlock Text="{Binding OutcomeText}" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OutcomeTone}" Value="Good">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Good}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OutcomeTone}" Value="Bad">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Took" Width="70"
                                                    DisplayMemberBinding="{Binding TookText}"/>
                                    <GridViewColumn Header="Time left" Width="78"
                                                    DisplayMemberBinding="{Binding RemainingText}"/>
                                    <GridViewColumn Header="Rate" Width="115"
                                                    DisplayMemberBinding="{Binding RateText}"/>
                                    <GridViewColumn Header="Drive Types" Width="125"
                                                    DisplayMemberBinding="{Binding DrivesText}"/>
                                    <GridViewColumn Header="Result" Width="230">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ResultText}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ResultText}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Every file that did not make it this session, with why. Double-click
                             opens its transfer on the failed files. -->
                        <ListView x:Name="FailedLog" BorderThickness="0" Visibility="Collapsed"
                                  Background="{DynamicResource Content}" Foreground="{DynamicResource Text}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  MouseDoubleClick="OnFailedRowActivated"
                                  ToolTip="Double-click to open the transfer it belongs to.">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Timestamp" Width="80" DisplayMemberBinding="{Binding WhenText}"/>
                                    <GridViewColumn Header="User" Width="120" DisplayMemberBinding="{Binding Peer}"/>
                                    <GridViewColumn Header="Direction" Width="150" DisplayMemberBinding="{Binding Direction}"/>
                                    <GridViewColumn Header="File" Width="380">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding File}" TextTrimming="CharacterEllipsis" ToolTip="{Binding File}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Why" Width="480">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Reason}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock x:Name="TransferLogEmpty"
                                   Text="Nothing has moved yet this session."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Subtle}" FontSize="13"
                                   IsHitTestVisible="False"/>

                        <!-- Network events stay a plain running log: they are one-off notes,
                             not transfers, and there is nothing to total up. -->
                        <ListBox x:Name="LogList" Background="{DynamicResource Content}"
                                 Visibility="Collapsed"
                                 BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TimeText}" Width="62"
                                                   Foreground="{DynamicResource Subtle}"/>
                                        <TextBlock Text="{Binding Arrow}" Width="20">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Good}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Upload">
                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SizeText}" Width="78"
                                                   Foreground="{DynamicResource Subtle}"/>
                                        <TextBlock Text="{Binding RateText}" Width="86"
                                                   Foreground="{DynamicResource Subtle}"/>
                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>

                                        <!-- Only batched lines carry a full list worth opening. -->
                                        <Button Content="show" Margin="10,0,0,0" Padding="4,0" MinWidth="0"
                                                Style="{StaticResource Ghost}"
                                                Foreground="{DynamicResource Accent}"
                                                Click="OnShowBatchClick"
                                                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisible}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ================= STATISTICS ================= -->
            <TabItem Header="Stats">
                <Border Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,1,0,0" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                            <DockPanel>
                                <Button x:Name="ClearStatsButton" DockPanel.Dock="Right"
                                        Content="Reset totals" MinWidth="110" Margin="0"
                                        Style="{StaticResource Danger}" Click="OnClearStatsClick"
                                        ToolTip="Clears the all-time totals only. The top ten and the History tab are untouched."/>
                                <TextBlock Text="All time" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="LifetimeSince" Margin="0,2,0,12" FontSize="11"
                                       Foreground="{DynamicResource Subtle}"/>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,20,14">
                                    <TextBlock Text="Downloaded" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="LifeDownBytes" Text="0 B" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LifeDownFiles" Text="0 files" FontSize="11"
                                               Foreground="{DynamicResource Subtle}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,14">
                                    <TextBlock Text="Uploaded" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="LifeUpBytes" Text="0 B" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LifeUpFiles" Text="0 files" FontSize="11"
                                               Foreground="{DynamicResource Subtle}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,14">
                                    <TextBlock Text="Moved in total" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="LifeTotalBytes" Text="0 B" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LifeTotalFiles" Text="0 files" FontSize="11"
                                               Foreground="{DynamicResource Subtle}"/>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,20,14">
                                    <TextBlock Text="Sessions" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="LifeRuns" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,14">
                                    <TextBlock Text="Best rate seen" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="LifePeak" Text="0 B/s" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,14">
                                    <TextBlock Text="Largest single file" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                                    <TextBlock x:Name="LifeBiggest" Text="0 B" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </UniformGrid>

                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,10,0,20"/>

                            <DockPanel Margin="0,0,0,4">
                                <Button x:Name="ClearBiggestButton" DockPanel.Dock="Right"
                                        Content="Reset top 10" MinWidth="110" Margin="0"
                                        Style="{StaticResource Danger}" Click="OnClearBiggestClick"
                                        ToolTip="Clears the top ten only. The all-time totals and the History tab are untouched."/>
                                <TextBlock Text="Top 10 biggest transfers" FontSize="16"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Margin="0,0,0,10" FontSize="11"
                                       Foreground="{DynamicResource Subtle}"
                                       Text="The largest single files ever moved, either direction."/>

                            <ItemsControl x:Name="BiggestList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Rank}"
                                                       Width="28" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Subtle}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}"
                                                       FontWeight="SemiBold" MinWidth="90"
                                                       TextAlignment="Right" Margin="12,0,0,0"/>
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                <Run Text="{Binding DirectionText, Mode=OneWay}"
                                                     Foreground="{DynamicResource Subtle}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="BiggestEmpty" Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource Subtle}"
                                       Text="Nothing yet — transfer something and it will appear here."/>

                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource Subtle}"
                                       Text="All-time figures are kept in config.json and survive restarts. Deleting that file resets them."/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ================= HISTORY ================= -->
            <TabItem Header="History">
                <DockPanel Background="{DynamicResource Chrome}">

                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,1,0,1" Padding="12,10">
                        <DockPanel>
                            <Button x:Name="ClearHistoryButton" DockPanel.Dock="Right" Content="Clear history"
                                    MinWidth="110" Margin="0" Style="{StaticResource Danger}"
                                    Click="OnClearHistoryClick"/>
                            <StackPanel>
                                <TextBlock Text="Every transfer" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HistorySummary" FontSize="11"
                                           Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="HistoryEmpty" Text="No transfers yet."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Subtle}" FontSize="13"
                               Visibility="Collapsed"/>

                    <ListView x:Name="HistoryList" BorderThickness="0"
                              Background="{DynamicResource Content}"
                              Foreground="{DynamicResource Text}"
                              MouseDoubleClick="OnHistoryRowActivated"
                              PreviewMouseLeftButtonDown="OnHistoryListClick"
                              ToolTip="Double-click a transfer to see the files it moved."
                              VirtualizingPanel.IsVirtualizing="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Timestamp" Width="150"
                                                DisplayMemberBinding="{Binding WhenText}"/>
                                <GridViewColumn Header="User" Width="150"
                                                DisplayMemberBinding="{Binding Peer}"/>
                                <GridViewColumn Header="Direction" Width="160"
                                                DisplayMemberBinding="{Binding Arrow}"/>
                                <GridViewColumn Header="Contents" Width="180"
                                                DisplayMemberBinding="{Binding ContentsText}"/>
                                <GridViewColumn Header="Size" Width="100"
                                                DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="Took" Width="90"
                                                DisplayMemberBinding="{Binding TookText}"/>
                                <GridViewColumn Header="Average" Width="190"
                                                DisplayMemberBinding="{Binding RateText}"/>
                                <GridViewColumn Header="Result" Width="200"
                                                DisplayMemberBinding="{Binding ResultText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

        </TabControl>
      </Grid>
    </DockPanel>
</Window>
