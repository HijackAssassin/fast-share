<Window x:Class="FastShare.ApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection request" Width="470" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Chrome}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI">

    <Border Padding="22,20">
        <StackPanel>

            <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Text="Someone wants to connect"/>

            <Border x:Name="IdentityBox" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,8"
                    CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource DangerBg}" BorderBrush="{DynamicResource DangerBorder}">
                <TextBlock x:Name="IdentityText" TextWrapping="Wrap" Foreground="{DynamicResource Text}"/>
            </Border>

            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="4"
                    Background="{DynamicResource Content}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="From" Width="70"
                                   Foreground="{DynamicResource Subtle}"/>
                        <TextBlock x:Name="FromText" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="Address" Width="70"
                                   Foreground="{DynamicResource Subtle}"/>
                        <TextBlock x:Name="AddressText" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="ID" Width="70"
                                   Foreground="{DynamicResource Subtle}"/>
                        <TextBlock x:Name="IdText" FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource Subtle}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,18,0,10" FontWeight="SemiBold" Text="Allow them to:"/>

            <CheckBox x:Name="DownloadSwitch" Style="{StaticResource Switch}"
                      Content="Download — read and copy files from your shared folders"/>
            <CheckBox x:Name="SendSwitch" Style="{StaticResource Switch}"
                      Content="Send — add files into your shared folders"/>
            <CheckBox x:Name="ModifySwitch" Style="{StaticResource Switch}"
                      Content="Modify (rename, move, new folders)"/>
            <CheckBox x:Name="DeleteSwitch" Style="{StaticResource Switch}"
                      Content="Delete — permanently remove your files"/>

            <CheckBox x:Name="AutoApproveBox" Margin="0,12,0,0" Foreground="{DynamicResource Text}"
                      Content="Allow this user to connect without requesting"/>
            <TextBlock x:Name="AutoApproveNote" Margin="24,2,0,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource Subtle}"
                       Text="Only when their PC proves it is the same one you let in before (FastShare 2.4 or later on their side). Anyone else using their ID is still asked about."/>

            <TextBlock x:Name="FoldersHeading" Margin="0,14,0,8" FontWeight="SemiBold"
                       Text="Folders they can see:"/>
            <Border x:Name="FoldersBox" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="4" MaxHeight="132" Background="{DynamicResource Content}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ShareChoices" Margin="12,9">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" Margin="0,3"
                                          Foreground="{DynamicResource Text}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource Subtle}"
                       Text="These are enforced on this PC, not on theirs. Everything left off is refused outright. Deleting cannot be undone — there is no Recycle Bin."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="AcceptButton" Content="Accept" MinWidth="92"
                        Style="{StaticResource Primary}" Click="OnAcceptClick"/>
                <Button Content="Kick" MinWidth="92" Click="OnRejectClick"
                        ToolTip="Refuse for now. They cannot reconnect until you restart FastShare."/>
                <Button Content="Block" MinWidth="92" Margin="0"
                        Style="{StaticResource Danger}" Click="OnBlockClick"
                        ToolTip="Refuse permanently. Manage blocked users in Settings."/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
