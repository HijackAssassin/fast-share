<Project Sdk="Microsoft.NET.Sdk">

  <!-- The standalone update listener Patrick can run when the main app is closed.
       It shares the main project's Updater, CertStore and AppConfig sources so the build it
       serves, the certificate it presents and the paths it reads are all identical to the
       main app's - the friend's pinned fingerprint has to match either way. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FastShare</RootNamespace>
    <AssemblyName>FastShareUpdateServer</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Src>..</Src>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(Src)\Updater.cs" />
    <Compile Include="$(Src)\CertStore.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
